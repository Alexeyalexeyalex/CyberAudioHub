# --- Окружения и мусор Python ---
__pycache__/
*.py[cod]
venv/
.venv/

# --- Личные данные, которых в репозитории быть не должно ---

# База: пользователи, пароли, прогресс, токен распознавателя.
# Сама папка нужна — приложение создаёт базу при первом запуске.
data/*
!data/.gitkeep
!data/folder_covers/
data/folder_covers/*
!data/folder_covers/.gitkeep

# Медиатека: аудиокниги, документы книг и распознанный текст рядом с ними.
static/music/*
!static/music/.gitkeep

# Настройки распознавателя: в них вписан токен доступа к серверу.
# Создаются сами при первом запуске worker/main.py.
worker/config.ini
worker/temp/

# --- Локальное окружение разработки ---
.claude/
*.apk
