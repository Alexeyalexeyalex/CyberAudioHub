<?xml version="1.0" encoding="utf-8"?>
<!-- Заглушка на месте обложки: пока картинка летит по сети и если её нет.
     Без рамки — обводка вокруг каждой обложки дробила бы полку. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/default_cover" />
</layer-list>
