<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Тёмная основа под стиль сайта: неон читается только на тёмном -->
    <style name="Theme.CyberAudio" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#00F2FF</item>
        <item name="colorSecondary">#E6ACF0</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:navigationBarColor">@color/dark_bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.CyberAudio.Dialog</item>
        <item name="colorSurface">#1D162B</item>
        <item name="colorOnSurface">#F0EEF7</item>
    </style>
    <style name="ThemeOverlay.CyberAudio.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">#1D162B</item>
        <item name="colorOnSurface">#F0EEF7</item>
        <item name="colorPrimary">#00F2FF</item>
        <item name="android:textColorPrimary">#F0EEF7</item>
        <item name="android:textColorSecondary">#A7A1B8</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.CyberAudio.Dialog</item>
    </style>
    <style name="Shape.CyberAudio.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">24dp</item>
    </style>
</resources>
